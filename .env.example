# ---- Identity & Politeness ----
CRAWLER_USER_AGENT=CrawlMind/1.0 (+https://github.com/yourname/crawlmind; contact@example.com)
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_ROBOTS_FAILURE_POLICY=allow_on_404_deny_on_error
CRAWLER_DEFAULT_DELAY_SECONDS=1.0

# ---- Scope ----
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_PAGES=100
CRAWLER_ALLOWED_DOMAINS=
CRAWLER_MAX_URL_LENGTH=2048
CRAWLER_MAX_QUERY_PARAMS=10
CRAWLER_FOLLOW_REDIRECTS=true
CRAWLER_MAX_REDIRECTS=5

# ---- Concurrency ----
CRAWLER_GLOBAL_CONCURRENCY=10
CRAWLER_PER_DOMAIN_CONCURRENCY=2

# ---- Timeouts & Retries ----
CRAWLER_REQUEST_TIMEOUT_SECONDS=30
CRAWLER_CONNECT_TIMEOUT_SECONDS=10
CRAWLER_READ_TIMEOUT_SECONDS=20
CRAWLER_MAX_RETRIES=3
CRAWLER_BASE_RETRY_DELAY_SECONDS=1.0
CRAWLER_MAX_RETRY_DELAY_SECONDS=60.0
CRAWLER_MAX_RESPONSE_BYTES=5242880

# ---- Storage ----
CRAWLER_DATABASE_PATH=data/crawlmind.db
CRAWLER_OUTPUT_DIRECTORY=output
CRAWLER_STORE_RAW_HTML=false
CRAWLER_LOG_LEVEL=INFO
CRAWLER_LOG_FORMAT=json

# ---- Security ----
CRAWLER_ALLOWLIST_MODE=false
CRAWLER_BLOCK_PRIVATE_NETWORKS=true

# ---- Optional features (all OFF by default) ----
CRAWLER_ENABLE_JS_RENDERING=false
CRAWLER_JS_RENDER_DOMAINS=
CRAWLER_ENABLE_LLM=false
CRAWLER_ENABLE_MCP=false

# ---- LLM ----
LLM_PROVIDER=disabled
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MAX_INPUT_CHARS=8000
LLM_MAX_OUTPUT_TOKENS=512
LLM_REDACT_PII=true
LLM_ALLOW_EXTERNAL=false
